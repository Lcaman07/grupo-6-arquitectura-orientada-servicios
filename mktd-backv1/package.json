{
  "name": "marketdata-api",
  "version": "1.0.0",
  "description": "MarketData Perú - API REST SOA (Controller-Service-Model) que integra INEI (REST/JSON) y SUNAT (SOAP/XML)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "cross-env APP_PROFILE=dev nodemon src/server.js",
    "start:dev": "cross-env APP_PROFILE=dev node src/server.js",
    "start:tst": "cross-env APP_PROFILE=tst node src/server.js",
    "start:prd": "cross-env APP_PROFILE=prd node src/server.js",
    "test": "node --test test/unit.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
