# =====================================================================
#  Plantilla del back. Copia este archivo como .env (o .env.dev / .env.tst / .env.prd)
#  y completa los valores. Los .env reales NO se suben a git (.gitignore).
#  Las variables marcadas [OBLIGATORIA] no tienen valor por defecto: sin ellas el back no arranca.
#  Lo que decide el negocio (prefijos, garantía máxima, etiquetas) NO va aquí:
#  está en Maestros > Multitabla > Parametro General.
# =====================================================================

#-- Perfil (también se puede pasar al iniciar: npm run start:prd)
# APP_PROFILE=dev

#-- WEB
SERVER_PORT=8081
SERVER_HOST=localhost
CONTEXT_PATH=/marketdata-api
#-- Tamaño máximo del JSON que recibe el back (MB)
JSON_LIMIT_MB=2
#-- gzip de las respuestas del back
HTTP_COMPRESSION=true

#-- Logging (error | warn | info | debug)
LOG_LEVEL=info
LOG_DIR=
LOG_FILE_PREFIX=marketdata
LOG_RETENTION_DAYS=14

#-- Cross-Domain (CORS): en producción pon la URL del front, ej. http://192.168.0.10
CORS_ORIGINS=*
CORS_HEADERS=*
CORS_METHODS=OPTIONS,HEAD,GET,PUT,POST,DELETE,PATCH
CORS_EXPOSED_HEADERS=Content-Disposition

#-- Archivos (foto del usuario, fondo del login)
UPLOAD_MAX_FILE_SIZE_MB=5
#-- Carpeta donde se guardan. Vacío = ./uploads
UPLOAD_DIR=

#-- Base de datos
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketdata_db
#-- [OBLIGATORIA]
DB_USERNAME=root
DB_PASSWORD=123456
DB_TIMEZONE=-05:00
DB_SHOW_SQL=false
#-- Hostinger compartido: pocas conexiones (el plan limita las conexiones por usuario)
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_POOL_EVICT_MS=10000
DB_CONNECT_TIMEOUT_MS=10000
#-- reintentos si la conexión con MySQL se corta
DB_RETRY_MAX=3

#-- Integración SOA (servicios externos)
#--   INEI  (REST/JSON) y SUNAT (SOAP/XML). Vacío = los servicios simulados que trae este back:
#--   INEI_URL  = http://localhost:8081/marketdata-api/mock/inei/api/v1
#--   SUNAT_URL = http://localhost:8081/marketdata-api/mock/sunat/ws/ConsultaRuc
INEI_URL=
SUNAT_URL=
#-- true = el back también levanta los servicios simulados del INEI y la SUNAT (fines académicos)
MOCKS_HABILITADOS=true

#-- JWT
#-- [OBLIGATORIA] clave larga y aleatoria, distinta en cada perfil. Si cambia, todos deben volver a iniciar sesión
JWT_SECRET=
JWT_ISSUER=marketdata-api
JWT_AUDIENCE=web
JWT_TIEMPO_SESION_MIN=20

#-- Contraseñas
BCRYPT_ROUNDS=10
#-- Minutos de validez del enlace para restablecer la contraseña
RESET_TOKEN_MINUTOS=10

#-- Correo (contraseña de aplicación de Gmail, nunca la contraseña normal)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=bcpnttdata@gmail.com
MAIL_PASSWORD=vlty dwyv phzj wpvv
MAIL_FROM=

#-- Front (para armar el enlace de "restablecer contraseña" del correo)
FRONT_URL=http://localhost/gwu-front
#-- Solo si la página de restablecer está en otra ruta
FRONT_RESET_URL=
