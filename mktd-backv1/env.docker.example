# =====================================================================
#  Variables para Docker (docker compose). Copia este archivo como .env.docker
#  y cambia TODAS las claves. .env.docker NO se sube a git.
#  El back toma de aquí lo mismo que de su .env normal (ver .env.example);
#  DB_HOST y DB_PORT los pone docker-compose.yml (el servicio "db").
# =====================================================================

#-- MySQL del contenedor: clave de root (solo para administrar, el back no la usa)
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

#-- Base y usuario del back (se crean solos la primera vez). No uses root.
DB_NAME=marketdata_db
DB_USERNAME=marketdata
DB_PASSWORD=cambia-esta-clave
DB_TIMEZONE=-05:00
DB_POOL_MAX=10

#-- WEB
SERVER_HOST=localhost
CONTEXT_PATH=/marketdata-api
#-- en producción pon la URL del front, ej. https://erp.tudominio.com
CORS_ORIGINS=*

#-- JWT: clave larga y aleatoria (ej. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_TIEMPO_SESION_MIN=20

#-- Logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

#-- Correo (contraseña de aplicación de Gmail)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

#-- URL del front (enlace de "olvidé mi contraseña")
FRONT_URL=http://localhost:8080/gwu-front

#-- Integración SOA (servicios externos)
#--   INEI  (REST/JSON) y SUNAT (SOAP/XML). Vacío = los servicios simulados que trae este back:
#--   INEI_URL  = http://localhost:8081/marketdata-api/mock/inei/api/v1
#--   SUNAT_URL = http://localhost:8081/marketdata-api/mock/sunat/ws/ConsultaRuc
INEI_URL=
SUNAT_URL=
#-- true = el back también levanta los servicios simulados del INEI y la SUNAT (fines académicos)
MOCKS_HABILITADOS=true
